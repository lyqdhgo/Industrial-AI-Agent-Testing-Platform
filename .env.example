# IATP runtime
IATP_DATA_DIR=./data
IATP_ARTIFACT_DIR=./artifacts
IATP_AUTO_SEED=true
IATP_REPRODUCIBILITY_CHECK=true
IATP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 可选：替换领域包、用例、Agent 注册表与套件目录（默认见 README）
# IATP_DOMAIN_DIR=./domain/demo_reactor
# IATP_CASES_DIR=./cases
# IATP_AGENTS_FILE=./agents/agents.yaml
# IATP_SUITES_DIR=./suites

# 外部 Agent 的 Bearer Token。变量名必须与 agents.yaml 中该 Agent 的 token_env 一致；
# 不要把 Token 写进 YAML 或证据文件。
# IATP_AGENT_TOKEN=
